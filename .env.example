# Local runtime settings. Copy this file to .env and edit as needed.

JOBCOCKPIT_DATABASE_URL=sqlite:///./var/jobcockpit.db
JOBCOCKPIT_ARTIFACT_ROOT=var/private/storage
# Leave unset to generate an installation-specific secret.
# JOBCOCKPIT_EXTENSION_TOKEN_SECRET=
# Optional drafting requires your own authenticated Codex CLI.
JOBCOCKPIT_EXTENSION_ANSWER_PROVIDER=disabled
JOBCOCKPIT_EXTENSION_ANSWER_MODEL=gpt-6-sol
JOBCOCKPIT_EXTENSION_ANSWER_REASONING_EFFORT=medium
JOBCOCKPIT_EXTENSION_ANSWER_TIMEOUT_SECONDS=180

# Development server ports used by scripts/dev.mjs.
JOBCOCKPIT_DEV_HOST=127.0.0.1
JOBCOCKPIT_API_PORT=8000
JOBCOCKPIT_WEB_PORT=3000
JOBCOCKPIT_ATS_MOCK_PORT=8001
# Keep recovering after native crashes, with backoff capped at 30 seconds.
JOBCOCKPIT_DEV_API_RESTART_LIMIT=-1
# Optional Windows native crash capture (see docs/dev-crash-dumps.md).
# JOBCOCKPIT_DEV_PROCDUMP=var/tools/procdump/procdump64.exe

# Gmail provider. Use "synthetic" for local fixtures or "google" for real
# Gmail read-only API fetching after OAuth authorization.
JOBCOCKPIT_GMAIL_PROVIDER=synthetic
JOBCOCKPIT_GMAIL_OAUTH_TOKEN_PATH=var/private/gmail/token.json
JOBCOCKPIT_GMAIL_MAX_RESULTS=25
JOBCOCKPIT_GMAIL_SCAN_MAX_RESULTS=250
JOBCOCKPIT_GMAIL_REQUEST_MIN_INTERVAL_SECONDS=1
JOBCOCKPIT_GMAIL_READ_MAX_RETRIES=6
# JOBCOCKPIT_GMAIL_OAUTH_CLIENT_SECRET_PATH=var/private/gmail/client_secret.json
# JOBCOCKPIT_GMAIL_OAUTH_LOCAL_SERVER_PORT=0

# External posting discovery uses Serper as JobCockpit's sole built-in web-search
# transport. Leave the API key blank in committed files and set it only in .env.
# Enable search/serper only after configuring your own key.
JOBCOCKPIT_POSTING_RESOLVER_PROVIDER=disabled
JOBCOCKPIT_POSTING_SEARCH_PROVIDER=disabled
JOBCOCKPIT_POSTING_SEARCH_MAX_RESULTS=5
JOBCOCKPIT_SERPER_API_KEY=
JOBCOCKPIT_SERPER_COUNTRY=ca
JOBCOCKPIT_SERPER_LANGUAGE=en
JOBCOCKPIT_SERPER_TIMEOUT_SECONDS=15
JOBCOCKPIT_SERPER_MAX_ATTEMPTS=2

# Read-only RankAlpha jobs API ingestion. Keep the bearer token only in .env.
JOBCOCKPIT_RANKALPHA_JOBS_API_TOKEN=
# Custom provider names registered with jobcockpit.ingestion.llm_providers
# remain supported for local extensions.
# Parallel link preparation across board details and Gmail messages (1-4).
# Rendered fallback concurrency also caps this pool when enabled.
JOBCOCKPIT_INGESTION_LINK_CONCURRENCY=4
JOBCOCKPIT_POSTING_EXTERNAL_RESOLUTION_CONCURRENCY=4
# Rendered-page fallback uses patched Firefox only, including scheduled scans.
# Install with uv sync --extra invisible-browser and fetch the browser runtime.
# Chrome CDP and legacy fallback chains remain explicit troubleshooting options.
# Use disabled to turn off the shared posting browser fallback.
JOBCOCKPIT_POSTING_RENDERED_FALLBACK_PROVIDER=disabled
JOBCOCKPIT_POSTING_RENDERED_FALLBACK_TIMEOUT_SECONDS=120
JOBCOCKPIT_POSTING_RENDERED_REASONING_EFFORT=medium
JOBCOCKPIT_POSTING_RENDERED_FALLBACK_CONCURRENCY=2
# Optional JSON map of source-domain suffixes to additional provider-owned asset
# domain suffixes. This is additive; it does not disable private-network or
# cross-provider blocking.
# JOBCOCKPIT_SCHEDULED_RENDERED_EXTRA_DOMAIN_GROUPS={"jobs.vendor.example":["assets.vendor-cdn.example"]}
# Optional direct Playwright profile settings used only when provider is playwright_profile.
# If omitted, JobCockpit uses ./var/playwright-profile.
# JOBCOCKPIT_PLAYWRIGHT_USER_DATA_DIR=./var/playwright-profile
# JOBCOCKPIT_PLAYWRIGHT_CHANNEL=chrome
# JOBCOCKPIT_PLAYWRIGHT_PROFILE_DIRECTORY=Default
# JOBCOCKPIT_PLAYWRIGHT_HEADLESS=true
# Experimental Firefox profile (never reuse a Chrome profile). This provider
# also selects Eluta's rendered fallback; HTTP fetches still run first.
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_USER_DATA_DIR=./var/invisible-playwright-profile
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_SEED=42
# Set these to match your connection's location and preferred language.
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_TIMEZONE=America/Denver
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_LOCALE=en-US
# Automatically prepare recognized Indeed/Eluta verification sessions when needed.
# Profiles are isolated under USER_DATA_DIR/<site>/seed-<seed>.
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_AUTO_PREPARE=true
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_PREPARE_TIMEOUT_SECONDS=60
# JOBCOCKPIT_INVISIBLE_PLAYWRIGHT_PREPARE_COOLDOWN_SECONDS=300
# Optional Chrome CDP endpoint used by chrome_cdp and chrome_cdp_first. Chrome must
# already expose --remote-debugging-port=9222.
# JOBCOCKPIT_CHROME_CDP_ENDPOINT_URL=http://127.0.0.1:9222
# Keep false to prevent ingestion from launching a separate CDP Chrome process.
# JOBCOCKPIT_CHROME_CDP_AUTO_START=false
JOBCOCKPIT_CODEX_CLI_COMMAND=codex
JOBCOCKPIT_CODEX_CLI_MODEL=gpt-6-luna
# By default Codex CLI calls run with --ignore-user-config and --cd pinned to
# this repository root. Override only if the app is launched from another checkout.
# JOBCOCKPIT_CODEX_CLI_WORKSPACE=/path/to/JobCockpit
JOBCOCKPIT_CODEX_CLI_IGNORE_USER_CONFIG=true
# Keep false for codex_cli rendered fallback so the Chrome plugin is available.
JOBCOCKPIT_CODEX_CLI_RENDERED_IGNORE_USER_CONFIG=false

# Optional posting parser enrichment. Heuristic parsing is deterministic and
# remains the default. Set to codex_cli for the built-in Codex CLI parser, or to
# the name of a custom parser provider registered at app startup.
JOBCOCKPIT_POSTING_PARSER_PROVIDER=heuristic
JOBCOCKPIT_POSTING_PARSER_TIMEOUT_SECONDS=60
JOBCOCKPIT_POSTING_PARSER_MAX_INPUT_CHARS=12000
JOBCOCKPIT_POSTING_PARSER_REASONING_EFFORT=medium

# Optional outbound publication. Keep policy and credentials in ignored local files.
JOBCOCKPIT_PUBLICATION_ENABLED=false
# JOBCOCKPIT_PUBLICATION_POLICY_PATH=var/private/publication-policy.json
# JOBCOCKPIT_PUBLICATION_WRITE_TOKEN=

# Optional profile-aware fit analysis. Disabled keeps deterministic local
# imports. Set to codex_cli for the built-in Codex CLI analyzer, or to a custom
# provider registered at app startup.
JOBCOCKPIT_FIT_ANALYSIS_PROVIDER=disabled
JOBCOCKPIT_FIT_ANALYSIS_TIMEOUT_SECONDS=60
JOBCOCKPIT_FIT_ANALYSIS_MAX_INPUT_CHARS=16000
JOBCOCKPIT_FIT_ANALYSIS_REASONING_EFFORT=medium

# Reusable employer research. A successful profile is stored once in SQLite and
# reused across jobs and cover-letter regenerations for the same company.
JOBCOCKPIT_COMPANY_PROFILE_RESEARCH_PROVIDER=disabled
JOBCOCKPIT_COMPANY_PROFILE_RESEARCH_TIMEOUT_SECONDS=180
JOBCOCKPIT_COMPANY_PROFILE_REASONING_EFFORT=medium

# Position-specific cover-letter generation. The draft uses the cached company
# profile and never searches for position details.
JOBCOCKPIT_COVER_LETTER_GENERATOR_PROVIDER=heuristic
JOBCOCKPIT_COVER_LETTER_GENERATOR_MODEL=gpt-6-sol
JOBCOCKPIT_COVER_LETTER_VERIFICATION_MODEL=gpt-6-luna
JOBCOCKPIT_COVER_LETTER_GENERATOR_TIMEOUT_SECONDS=360
JOBCOCKPIT_COVER_LETTER_GENERATOR_MAX_INPUT_CHARS=20000
JOBCOCKPIT_COVER_LETTER_GENERATOR_REASONING_EFFORT=medium
JOBCOCKPIT_COVER_LETTER_VERIFICATION_REASONING_EFFORT=medium
JOBCOCKPIT_COVER_LETTER_VERIFICATION_MAX_ATTEMPTS=4

# Optional. If omitted, scripts/dev.mjs derives this from JOBCOCKPIT_DEV_HOST
# and JOBCOCKPIT_API_PORT, then passes it to the web dashboard.
# JOBCOCKPIT_API_BASE_URL=http://127.0.0.1:8000
