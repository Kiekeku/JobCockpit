{
  "manifest_version": 3,
  "name": "JobCockpit Assistant",
  "version": "0.3.3",
  "minimum_chrome_version": "116",
  "description": "Review application questions, draft grounded answers, and fill approved native fields on Workday. Capture postings into local JobCockpit.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "sidePanel"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open JobCockpit application companion"
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "dist/background.js", "type": "module" }
}
